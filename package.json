{
  "name": "matrix-mixer-desktop",
  "version": "1.5.0",
  "description": "Helix Stadium 1.4 Matrix Mixer Desktop & Stage Wi-Fi Hub",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "start": "electron .",
    "dist:mac": "node build.js && electron-builder --mac",
    "dist:win": "node build.js && electron-builder --win --x64",
    "dist:all": "node build.js && electron-builder -mw"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "mermaid": "^12.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.helix.matrixmixer",
    "productName": "Helix Matrix Mixer",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "dist/server.js",
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "dist/database/**/*",
      "package.json"
    ]
  }
}
